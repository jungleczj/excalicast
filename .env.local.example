# Creem (https://creem.io) — 复制为 .env.local 并填入真实值
# 单次购买价格（最小货币单位，如 USD cents → 200 = $2.00）
SINGLE_PURCHASE_PRICE_CENTS=300
SINGLE_PURCHASE_CURRENCY=usd

# Creem API
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=

# 部署后的公开 URL（Creem 回跳目标）
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 开发模式：true 时启用 /api/dev/simulate-payment 模拟支付端点 + LoginModal 的开发邮箱登录
DEV_MODE=true

# ── NextAuth.js (auth.js v5) ─────────────────────────────
# 必填：32+ 位随机字符串。生成：openssl rand -base64 32
AUTH_SECRET=

# 可选：Google OAuth（在 https://console.cloud.google.com/ 创建 OAuth 凭证）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 可选：GitHub OAuth（在 https://github.com/settings/developers 创建 OAuth App）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
