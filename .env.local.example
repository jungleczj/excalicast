# Paddle (https://paddle.com) — 复制为 .env.local 并填入真实值
# Sandbox 后台：https://sandbox-vendors.paddle.com
# Production 后台：https://vendors.paddle.com
NEXT_PUBLIC_PADDLE_ENV=sandbox          # 'sandbox' | 'production'
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=        # client token，必须 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_PADDLE_PRICE_ID=            # one-time price ID（去水印 $4.99），例 pri_01...
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=        # Pro 订阅 price ID（recurring monthly $9.99），例 pri_01... — 必须在 Paddle 后台先创建产品+price
NEXT_PUBLIC_PADDLE_MAX_PRICE_ID=        # Max 订阅 price ID（recurring monthly $15.99），例 pri_01... — 同样需在 Paddle 后台先建产品+price
PADDLE_API_KEY=                         # 服务端 API key（暂未使用，预留给后续退款 / API 操作）
PADDLE_WEBHOOK_SECRET=                  # Notification destination 的 secret key

# 部署后的公开 URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 开发模式：true 时启用 /api/dev/simulate-payment + PaywallModal 的 dev 跳过链接
# 同时启用 LoginModal 的开发邮箱登录
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true

# ── NextAuth.js (auth.js v5) ─────────────────────────────
# 必填：32+ 位随机字符串。生成：openssl rand -base64 32
AUTH_SECRET=

# 可选：Google OAuth（在 https://console.cloud.google.com/ 创建 OAuth 凭证）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 可选：GitHub OAuth（在 https://github.com/settings/developers 创建 OAuth App）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── 阿里千问 / DashScope（AI 字幕，Pro 功能）─────────────
# 申请：https://dashscope.console.aliyun.com/apiKey
# 注意：服务端使用，绝不能暴露到前端（不带 NEXT_PUBLIC_ 前缀）
# 未设置时：本地开发使用 mock SRT，UI 流程仍可走通
DASHSCOPE_API_KEY=

# DashScope ASR 路径要求音频通过公网 URL 给阿里抓取
# 如果 NEXT_PUBLIC_APP_URL 是 localhost，将自动 fallback 到 mock SRT
# 真实环境部署到公网域名后自动启用千问 Paraformer-v2 模型

# ── Admin / Payment Config（后台支付配置） ───────────────
# Admin API: GET/POST /api/admin/payment-config
# 调用必须带 header  x-admin-secret: <ADMIN_SECRET>
# 未设置时所有 admin 写入直接 403，防误暴露
ADMIN_SECRET=

# ── Creem (https://creem.io) ─────────────────────────────
# 仅当 payment_config.provider='creem'（admin API 设置）时启用
CREEM_API_KEY=                          # 形如 creem_xxx
CREEM_WEBHOOK_SECRET=                   # HMAC-SHA256 验签 (header: creem-signature)
CREEM_API_BASE=https://test-api.creem.io/v1   # prod 用 https://api.creem.io/v1
CREEM_ONE_TIME_PRODUCT_ID=              # prod_xxx，单次去水印（onetime billing_type）
CREEM_PRO_PRODUCT_ID=                   # prod_xxx，Pro 月订阅（recurring billing_type）
CREEM_MAX_PRODUCT_ID=                   # prod_xxx，Max 月订阅（recurring billing_type）

# Creem 后台 webhook endpoint 配为：
#   ${NEXT_PUBLIC_APP_URL}/api/creem-webhook
# 至少订阅事件：checkout.completed / subscription.active / subscription.canceled
