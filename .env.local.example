# Paddle (https://paddle.com) — 复制为 .env.local 并填入真实值
# Sandbox 后台：https://sandbox-vendors.paddle.com
# Production 后台：https://vendors.paddle.com
NEXT_PUBLIC_PADDLE_ENV=sandbox          # 'sandbox' | 'production'
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=        # client token，必须 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_PADDLE_PRICE_ID=            # one-time price ID，例 pri_01...
PADDLE_API_KEY=                         # 服务端 API key（暂未使用，预留给后续退款 / API 操作）
PADDLE_WEBHOOK_SECRET=                  # Notification destination 的 secret key

# 部署后的公开 URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 开发模式：true 时启用 /api/dev/simulate-payment + PaywallModal 的 dev 跳过链接
# 同时启用 LoginModal 的开发邮箱登录
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true

# ── NextAuth.js (auth.js v5) ─────────────────────────────
# 必填：32+ 位随机字符串。生成：openssl rand -base64 32
AUTH_SECRET=

# 可选：Google OAuth（在 https://console.cloud.google.com/ 创建 OAuth 凭证）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 可选：GitHub OAuth（在 https://github.com/settings/developers 创建 OAuth App）
# 回调 URL 配置为 ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
