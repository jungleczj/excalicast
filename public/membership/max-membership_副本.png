<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" fill="none" role="img" aria-label="Excalicast Max membership product illustration">
  <defs>
    <style>
      .serif{font-family:Georgia,'Noto Serif SC','Songti SC',serif}
      .sans{font-family:Inter,Geist,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
      .light{fill:#FFFDF8}.soft{fill:#D8D0C4}.gold{fill:#F9D05A}.ink{fill:#1F2225}
    </style>
    <pattern id="maxGrain" width="134" height="134" patternUnits="userSpaceOnUse">
      <circle cx="14" cy="20" r="1.05" fill="#F9D05A" opacity=".18"/>
      <circle cx="88" cy="46" r=".95" fill="#FFF8E7" opacity=".10"/>
      <circle cx="48" cy="106" r="1" fill="#BFE0F5" opacity=".08"/>
    </pattern>
    <filter id="maxShadow" x="-14%" y="-18%" width="130%" height="142%">
      <feDropShadow dx="0" dy="28" stdDeviation="38" flood-color="#000000" flood-opacity=".34"/>
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity=".18"/>
    </filter>
    <filter id="darkLift" x="-8%" y="-8%" width="116%" height="116%">
      <feDropShadow dx="0" dy="9" stdDeviation="12" flood-color="#000000" flood-opacity=".16"/>
    </filter>
    <symbol id="logoMark" viewBox="0 0 32 32">
      <rect x="3.6" y="3.4" width="24.8" height="25" rx="6.2" fill="#FFFCF5"/>
      <path d="M9.2 22.6 L14.3 16.7 c1.1 -1.3 2.5 -1.2 3.5 0.1 l2.1 2.7 l2.9 -3.5 c0.9 -1.1 2.1 -1 3 0.2 l2.1 2.9 v4.4 c0 1.9 -1 2.9 -3 2.9 H7.2 c-1.7 0 -2.7 -0.8 -2.9 -2.2 c1.5 -0.4 3.1 -0.9 4.9 -1.6 z" fill="#BFE0F5"/>
      <path d="M16.8 26.4 L21.8 18.2 c0.8 -1.3 2.2 -1.3 3 0 l3.1 5 v0.6 c0 1.7 -0.9 2.6 -2.6 2.6 z" fill="#F9D05A"/>
      <circle cx="10.1" cy="9.1" r="2.6" fill="#F0443E"/>
      <rect x="3.6" y="3.4" width="24.8" height="25" rx="6.2" fill="none" stroke="#1F2225" stroke-width="2.35"/>
    </symbol>
  </defs>

  <rect width="1920" height="1080" rx="72" fill="#171512"/>
  <rect width="1920" height="1080" fill="url(#maxGrain)"/>
  <path d="M0 144C170 190 326 180 510 118C708 50 930 76 1136 166C1392 278 1646 242 1920 132V0H0Z" fill="#2A2722"/>
  <path d="M0 790C238 672 416 666 654 760C900 856 1114 870 1360 732C1588 604 1740 626 1920 710V1080H0Z" fill="#22201D"/>
  <path d="M104 674L520 596L580 946L144 1012Z" fill="#F9D05A" opacity=".92" filter="url(#darkLift)"/>
  <path d="M1328 154L1802 220L1718 610L1268 550Z" fill="#BFE0F5" opacity=".52" filter="url(#darkLift)"/>
  <path d="M1440 728L1856 672L1920 1076L1476 1080Z" fill="#DAD2F1" opacity=".38" filter="url(#darkLift)"/>

  <g transform="translate(154 122)">
    <use href="#logoMark" width="70" height="70"/>
    <text x="92" y="43" class="sans light" font-size="32" font-weight="720" letter-spacing="-.02em">Excalicast</text>
  </g>

  <g transform="translate(154 254)">
    <text x="0" y="0" class="serif light" font-size="78" letter-spacing="-2.9">Max turns work</text>
    <text x="0" y="86" class="serif light" font-size="78" letter-spacing="-2.9">into an archive.</text>
    <text x="0" y="158" class="sans soft" font-size="27">Shared links, handouts, outlines,</text>
    <text x="0" y="196" class="sans soft" font-size="27">and a searchable recording library.</text>
    <g transform="translate(0 232)">
      <rect width="252" height="70" rx="35" fill="#FFFDF8"/>
      <circle cx="42" cy="35" r="9" fill="#F0443E"/>
      <text x="70" y="44" class="sans ink" font-size="25" font-weight="860">Upgrade Max</text>
    </g>
    <g transform="translate(284 232)">
      <rect width="282" height="70" rx="35" fill="#24211D" stroke="#4B453C" stroke-width="3"/>
      <text x="42" y="44" class="sans gold" font-size="24" font-weight="820">Assets</text>
      <text x="124" y="44" class="sans soft" font-size="22">ready</text>
    </g>
  </g>

  <g transform="translate(836 226)" filter="url(#maxShadow)">
    <rect width="948" height="692" rx="46" fill="#FFFDF8" stroke="#DED6CA" stroke-width="3"/>
    <g transform="translate(48 42)">
      <use href="#logoMark" width="42" height="42"/>
      <text x="58" y="29" class="sans ink" font-size="22" font-weight="820">Asset workspace</text>
      <rect x="610" y="-6" width="250" height="48" rx="24" fill="#0B0B0B"/>
      <text x="664" y="25" class="sans gold" font-size="19" font-weight="820">MAX · Shared</text>
    </g>

    <g transform="translate(58 120)">
      <rect width="382" height="498" rx="34" fill="#F7F2EA" stroke="#E7E0D5" stroke-width="3"/>
      <text x="36" y="62" class="sans ink" font-size="25" font-weight="880">Recording library</text>
      <g transform="translate(36 98)">
        <rect width="310" height="92" rx="24" fill="#FFFDF8" stroke="#EAE3D7" stroke-width="2"/>
        <rect x="24" y="22" width="112" height="50" rx="14" fill="#BFE0F5"/>
        <path d="M164 34H278M164 58H244" stroke="#90877B" stroke-width="8" stroke-linecap="round"/>
      </g>
      <g transform="translate(36 218)">
        <rect width="310" height="92" rx="24" fill="#FFFDF8" stroke="#EAE3D7" stroke-width="2"/>
        <rect x="24" y="22" width="112" height="50" rx="14" fill="#F9D05A"/>
        <path d="M164 34H280M164 58H252" stroke="#90877B" stroke-width="8" stroke-linecap="round"/>
      </g>
      <g transform="translate(36 338)">
        <rect width="310" height="92" rx="24" fill="#FFFDF8" stroke="#EAE3D7" stroke-width="2"/>
        <rect x="24" y="22" width="112" height="50" rx="14" fill="#DAD2F1"/>
        <path d="M164 34H280M164 58H236" stroke="#90877B" stroke-width="8" stroke-linecap="round"/>
      </g>
    </g>

    <g transform="translate(480 120)">
      <rect width="408" height="232" rx="34" fill="#0B0B0B" stroke="#201E1B" stroke-width="3"/>
      <text x="36" y="64" class="sans light" font-size="25" font-weight="880">Shareable replay</text>
      <path d="M42 118H316" stroke="#BFE0F5" stroke-width="10" stroke-linecap="round"/>
      <path d="M42 158H270" stroke="#F9D05A" stroke-width="10" stroke-linecap="round"/>
      <rect x="272" y="130" width="96" height="52" rx="26" fill="#FFFDF8"/>
      <text x="300" y="164" class="sans ink" font-size="19" font-weight="880">Copy</text>
    </g>

    <g transform="translate(480 384)">
      <rect width="232" height="234" rx="34" fill="#FFF7D7" stroke="#E7E0D5" stroke-width="3"/>
      <text x="34" y="62" class="sans ink" font-size="23" font-weight="880">Outline</text>
      <path d="M38 104H172M38 140H146M38 176H190" stroke="#1F2225" stroke-opacity=".46" stroke-width="8" stroke-linecap="round"/>
    </g>
    <g transform="translate(736 384)">
      <rect width="232" height="234" rx="34" fill="#E8F5E3" stroke="#E7E0D5" stroke-width="3"/>
      <text x="34" y="62" class="sans ink" font-size="23" font-weight="880">Handout</text>
      <path d="M38 104H184M38 140H170M38 176H132" stroke="#1F2225" stroke-opacity=".46" stroke-width="8" stroke-linecap="round"/>
    </g>
  </g>
</svg>
